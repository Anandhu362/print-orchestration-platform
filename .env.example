# Application Configurations
NODE_ENV=development
PORT=8080

# WhatsApp Engine Configurations
WA_SESSION_ID=vecta-dev-session-01

# Google Cloud & Firebase Core Ecosystem Configurations
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com/
FIREBASE_STORAGE_BUCKET=your-cloud-storage-bucket-name

# Google Cloud Service Account Credentials
# Option 1 (Local Dev / Volume Mount): Relative or absolute path to JSON key file
GCP_SERVICE_ACCOUNT_PATH=./src/config/whatsapp-assistant-sa.json
# Option 2 (Cloud / Docker Env Secret): Direct JSON string or Base64-encoded string
# GCP_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Gemini AI Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google Sheets Configuration
GOOGLE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# Primary Admin WhatsApp JID/Number for Alerts & In-Chat Authorization Commands
PRIMARY_ADMIN_NUMBER=YOUR_ADMIN_PHONE_NUMBER@s.whatsapp.net

# Lead follow-ups and Timezone
DEFAULT_REMINDER_DAYS=2
TZ=Asia/Dubai

# ADSPRO Print Automation Configurations
ADSPRO_SHEET_ID=YOUR_ADSPRO_SPREADSHEET_ID_HERE

# Group Access Policy:
# Set to 'true' or set ADSPRO_GROUP_JID='*' or 'ALL' to accept orders from ALL groups where the bot is added
ALLOW_ALL_GROUPS=true
# Or specify comma-separated group JIDs:
# ADSPRO_GROUP_JID=120363412514415436@g.us,120363999999999999@g.us

# Direct Chat (1-on-1) Access Policy:
# - If false (default): Participants of your print groups are AUTO-AUTHORIZED, plus AUTHORIZED_SENDERS and Firestore.
# - If true: Anyone who has the bot's contact can send orders directly.
ALLOW_ALL_DIRECT=false

# Pre-authorized senders (comma-separated phone numbers or LIDs):
AUTHORIZED_SENDERS="918921156958,198650995183787,189360829902908,94296728404188"

# Serverless Cloud Run Worker Offloading (me-central1)
# When true, delegates heavy PDF rasterization, multimodal AI analysis, and sheet writing to Cloud Run
USE_CLOUD_RUN_WORKER=true
CLOUD_RUN_WORKER_URL=https://adspro-worker-581486365848.me-central1.run.app
CLOUD_RUN_TIMEOUT_MS=300000
